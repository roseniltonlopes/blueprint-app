# Configuração do Supabase do Blueprint.
# Copie este arquivo para .env e preencha com os dados do SEU projeto
# (Project Settings > API Keys no painel do Supabase). O .env não vai para o Git.
#
# URL: só a base do projeto, sem /rest/v1/ no final.
# Chave: use SOMENTE a "publishable" (sb_publishable_...). Nunca a "secret" nem a "service_role".

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave_aqui
