# Configuração do Supabase — App Blueprint
# Copie para .env (que o git ignora) e preencha com os valores do painel:
# Project Settings > API Keys. Reinicie o Expo com `npx expo start -c` depois de editar.

EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave PUBLICÁVEL (começa com sb_publishable_). Ela vai dentro do app e é pública
# por desenho: quem protege os dados é o RLS. NUNCA use a chave secret/service_role.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave_aqui

# Legado: a chave anon (JWT eyJ...) ainda funciona como alternativa, mas o Supabase
# vai desativá-la até o fim de 2026. Prefira a publicável acima.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
